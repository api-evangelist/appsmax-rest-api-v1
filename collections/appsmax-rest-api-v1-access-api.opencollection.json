{
  "opencollection": "1.0.0",
  "info": {
    "name": "AppsMax REST Access API",
    "version": "1.1.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Access",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Проверить API-токен",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://telegram.appsmax.ru/api/v1/ping"
          },
          "docs": "Требует действующий токен, но не требует отдельного scope."
        },
        {
          "info": {
            "name": "Получить токен и организацию",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://telegram.appsmax.ru/api/v1/me"
          },
          "docs": "Возвращает scopes и фактический rate limit токена. Отдельный scope не требуется."
        }
      ]
    }
  ],
  "bundled": true
}