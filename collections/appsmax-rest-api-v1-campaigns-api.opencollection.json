        {
          "info": {
            "name": "Создать кампанию",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://telegram.appsmax.ru/api/v1/campaigns",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
