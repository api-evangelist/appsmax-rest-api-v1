              {
                "name": "status[]",
                "value": "",
                "type": "query"
              },
              {
                "name": "type[]",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_from",
                "value": "",
                "type": "query"
              },
              {
                "name": "created_to",
